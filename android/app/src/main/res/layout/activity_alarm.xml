<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Top Area: Time and Label -->
    <LinearLayout
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="110dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/alarmClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:15"
            android:textColor="#FFFFFF"
            android:textSize="72sp"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/alarmTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Alarm"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/alarmMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#888888"
            android:textSize="15sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bottom Controls matching snooze_or_dismiss_image.jpeg -->
    <RelativeLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="75dp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <!-- Hint Text for Slide -->
        <TextView
            android:id="@+id/swipeHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center"
            android:layout_marginBottom="14dp"
            android:text="◂ Slide left to Snooze      Slide right to Dismiss ▸"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <RelativeLayout
            android:id="@+id/bottomButtonsTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/swipeHintText">

        <!-- Left: Snooze (zzz) -->
        <FrameLayout
            android:id="@+id/btnSnooze"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_ripple"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_snooze_zzz"
                android:contentDescription="Snooze" />

        </FrameLayout>

        <!-- Center: Circular White Alarm Icon Button -->
        <FrameLayout
            android:id="@+id/btnCenterAlarm"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_white_circle"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_alarm_black"
                android:contentDescription="Alarm Icon" />

        </FrameLayout>

        <!-- Right: Dismiss (Alarm off crossed) -->
        <FrameLayout
            android:id="@+id/btnDismiss"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_ripple"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_alarm_off_white"
                android:contentDescription="Dismiss" />

        </FrameLayout>

        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>